    "class Students:\n",
    "\n",
    "    def __init__(self, names):\n",
    "        self.names = names\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.names)\n",
    "\n",
    "\n",
    "students = Students([\"Rahul\", \"Priya\", \"Arun\"])\n",
    "\n",
    "print(len(students))"
   ]

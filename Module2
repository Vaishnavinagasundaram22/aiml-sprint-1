     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Payment completed using UPI\n"
     ]
    }
   ],
   "source": [
    "from abc import ABC, abstractmethod\n",
    "\n",
    "class Payment(ABC):\n",
    "\n",
    "    @abstractmethod\n",
    "    def pay(self):\n",
    "        pass\n",
    "\n",
    "\n",
    "class UPI(Payment):\n",
    "\n",
    "    def pay(self):\n",
    "        print(\"Payment completed using UPI\")\n",
    "\n",
    "\n",
    "payment = UPI()\n",
    "payment.pay()"
   ]
  },

     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Student(name='Rahul', age=22)\n"
     ]
    }
   ],
   "source": [
    "from dataclasses import dataclass\n",
    "\n",
    "@dataclass\n",
    "class Student:\n",
    "    name: str\n",
    "    age: int\n",
    "\n",
    "\n",
    "student = Student(\"Rahul\", 22)\n",
    "\n",
    "print(student)"
   ]
